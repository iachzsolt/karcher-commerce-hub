# Deno Deploy production runtime variables.
# Copy secret values from the existing secure local configuration;
# never commit real credentials.

NODE_ENV=production
DATABASE_URL=replace-with-neon-connection-string

ALLEGRO_ENV=PRODUCTION
ALLEGRO_CLIENT_ID=replace-with-existing-client-id
ALLEGRO_CLIENT_SECRET=replace-with-existing-client-secret
ALLEGRO_TOKEN_ENCRYPTION_KEY=replace-with-existing-base64-key
ALLEGRO_AUTH_URL=replace-with-existing-production-auth-url
ALLEGRO_TOKEN_URL=replace-with-existing-production-token-url
ALLEGRO_API_URL=replace-with-existing-production-api-url
ALLEGRO_REDIRECT_URI=https://hub.example.com/api/auth/allegro/callback
ALLEGRO_USER_AGENT=replace-with-existing-user-agent

COMMERCE_HUB_WEB_ORIGINS=https://hub.example.com
COMMERCE_HUB_AUTH_PROVIDER=google
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
COMMERCE_HUB_ALLOWED_EMAILS=colleague@example.com
COMMERCE_HUB_ADMIN_EMAILS=

# Keep both switches false for the first read-only deployment.
COMMERCE_HUB_ALLEGRO_SESSION_RESTORE_ENABLED=false
COMMERCE_HUB_SCHEDULERS_ENABLED=false
COMMERCE_HUB_DENO_CRON_ENABLED=false
ARUKERESO_SOURCE_FEED_URL=https://source.example.com/catalog.csv
ARUKERESO_SOURCE_FEED_USERNAME=replace-with-service-username
ARUKERESO_SOURCE_FEED_PASSWORD=replace-with-service-password
ARUKERESO_SOURCE_FEED_SCHEDULE_ENABLED=false
ARUKERESO_SOURCE_FEED_REFRESH_TIME=06:45
ARUKERESO_SOURCE_FEED_TIMEOUT_MS=30000
ARUKERESO_SOURCE_FEED_MAX_BYTES=26214400
ARUKERESO_SOURCE_FEED_MAX_ATTEMPTS=3
ARUKERESO_CATALOG_SNAPSHOT_MIN_RATIO=0.85
ARUKERESO_PRICING_SNAPSHOT_MIN_RATIO=0.60
COMMERCE_HUB_DATA_CONNECTION_SCHEDULES_ENABLED=false
COMMERCE_HUB_CATALOG_SYNC_ENABLED=false
COMMERCE_HUB_PRICE_SCHEDULES_ENABLED=false
COMMERCE_HUB_CAMPAIGN_AUTOMATION_ENABLED=false
# Allegro -> email notification bridge (V1). Keep disabled until the
# notification OAuth bootstrap and Apps Script relay are configured.
ALLEGRO_NOTIFY_ENABLED=false
ALLEGRO_NOTIFY_REDIRECT_URI=https://hub.example.com/api/auth/allegro/notify-callback
# Retired: the Deno -> Apps Script Web App relay is no longer read by
# active runtime logic. Leave unset for new environments.
# ALLEGRO_NOTIFY_RELAY_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec
ALLEGRO_NOTIFY_RELAY_SECRET=replace-with-random-secret
ALLEGRO_NOTIFY_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-bytes
ALLEGRO_NOTIFY_ORDER_EMAIL=orders@example.com
ALLEGRO_NOTIFY_MESSAGE_EMAIL=customerservice@example.com
ALLEGRO_NOTIFY_CANCELLATION_EMAIL=orders@example.com
