# Deno Deploy production runtime variables.
# Copy secret values from the existing secure local configuration;
# never commit real credentials.

NODE_ENV=production
DATABASE_URL=replace-with-neon-connection-string

ALLEGRO_ENV=PRODUCTION
ALLEGRO_CLIENT_ID=replace-with-existing-client-id
ALLEGRO_CLIENT_SECRET=replace-with-existing-client-secret
ALLEGRO_TOKEN_ENCRYPTION_KEY=replace-with-existing-base64-key
ALLEGRO_AUTH_URL=replace-with-existing-production-auth-url
ALLEGRO_TOKEN_URL=replace-with-existing-production-token-url
ALLEGRO_API_URL=replace-with-existing-production-api-url
ALLEGRO_REDIRECT_URI=https://hub.example.com/api/auth/allegro/callback
ALLEGRO_USER_AGENT=replace-with-existing-user-agent

COMMERCE_HUB_WEB_ORIGINS=https://hub.example.com
COMMERCE_HUB_AUTH_PROVIDER=google
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
COMMERCE_HUB_ALLOWED_EMAILS=colleague@example.com
COMMERCE_HUB_ADMIN_EMAILS=

# Keep both switches false for the first read-only deployment.
COMMERCE_HUB_SCHEDULERS_ENABLED=false
COMMERCE_HUB_DENO_CRON_ENABLED=false
