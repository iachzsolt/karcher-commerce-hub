PORT=3000
HOST=0.0.0.0
COMMERCE_HUB_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COMMERCE_HUB_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
COMMERCE_HUB_ACCESS_AUDIENCE=replace-with-access-application-aud
COMMERCE_HUB_ALLOWED_EMAILS=colleague@example.com
COMMERCE_HUB_ADMIN_EMAILS=admin@example.com
COMMERCE_HUB_ALLEGRO_SESSION_RESTORE_ENABLED=true
COMMERCE_HUB_SCHEDULERS_ENABLED=false
COMMERCE_HUB_DENO_CRON_ENABLED=false
COMMERCE_HUB_ARUKERESO_PRICING_SYNC_TOKEN=replace-with-random-secret
ARUKERESO_PUBLIC_FEED_TOKEN=replace-with-url-safe-random-token
ARUKERESO_REPORTS_API_KEY=replace-with-heureka-reports-api-key
ARUKERESO_AUTO_GENERATE_ENABLED=false
# Legacy shared fallback when a source-specific ratio is absent.
ARUKERESO_SNAPSHOT_MIN_RATIO=0.60
ARUKERESO_CATALOG_SNAPSHOT_MIN_RATIO=0.85
ARUKERESO_PRICING_SNAPSHOT_MIN_RATIO=0.60
ARUKERESO_SOURCE_FEED_URL=https://source.example.com/catalog.csv
ARUKERESO_SOURCE_FEED_USERNAME=replace-with-service-username
ARUKERESO_SOURCE_FEED_PASSWORD=replace-with-service-password
ARUKERESO_SOURCE_FEED_SCHEDULE_ENABLED=false
ARUKERESO_SOURCE_FEED_REFRESH_TIME=06:45
ARUKERESO_SOURCE_FEED_TIMEOUT_MS=30000
ARUKERESO_SOURCE_FEED_MAX_BYTES=26214400
ARUKERESO_SOURCE_FEED_MAX_ATTEMPTS=3
# Allegro -> email notification bridge (V1). Keep disabled until the
# notification OAuth bootstrap and Apps Script relay are configured.
ALLEGRO_NOTIFY_ENABLED=false
ALLEGRO_NOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/allegro/notify-callback
ALLEGRO_NOTIFY_RELAY_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec
ALLEGRO_NOTIFY_RELAY_SECRET=replace-with-random-secret
ALLEGRO_NOTIFY_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-bytes
ALLEGRO_NOTIFY_ORDER_EMAIL=orders@example.com
ALLEGRO_NOTIFY_MESSAGE_EMAIL=customerservice@example.com
ALLEGRO_NOTIFY_CANCELLATION_EMAIL=orders@example.com
